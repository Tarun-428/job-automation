# Application
APP_ENV=development
APP_SECRET_KEY=change-me-32-chars-minimum-secret
DEBUG=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://localhost:8000/telegram/webhook

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://tarun:tarun@localhost:5432/jobbot
DATABASE_URL_SYNC=postgresql://tarun:tarun@localhost:5432/jobbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=jobbot-tasks

# Ollama (local AI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MULTIMODAL_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=8

# AI Cloud Providers
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# AI Routing
AI_CONFIDENCE_THRESHOLD=0.75
AI_LOCAL_FIRST=true

# File Storage (S3 or local)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
SAVE_SCREENSHOTS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=jobbot-files
AWS_REGION=us-east-1

# Encryption
VAULT_ENCRYPTION_KEY=change-me-32-byte-fernet-key-here

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_STEALTH=true

# Resume
LATEX_ENGINE=tectonic

# Logging
LOG_FORMAT=json
