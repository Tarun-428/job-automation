FROM python:3.12-slim

# 1. Install ALL system dependencies manually (Debian-correct package names)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core utilities
    curl \
    libpq-dev \
    gcc \
    # Playwright/Chromium dependencies
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libx11-6 \
    libxcb1 \
    libxext6 \
    libxshmfence1 \
    libglib2.0-0 \
    libdbus-1-3 \
    libexpat1 \
    # Debian-correct font packages (NOT ttf-ubuntu-font-family or ttf-unifont)
    fonts-liberation \
    fonts-freefont-ttf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 2. Install browser binary ONLY — skip deps since we handled them above
RUN playwright install chromium

COPY . .

RUN mkdir -p /app/storage/resumes /app/storage/screenshots

CMD ["python", "main.py"]