FROM python:3.12-slim

# System deps
RUN apt-get update && apt-get install -y \
    curl wget git \
    libpq-dev gcc \
    # Essential fonts
    fonts-liberation fonts-unifont \
    # Playwright / Chromium dependencies
    libnss3 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 \
    libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/*


# Try to install tectonic
RUN curl -fsSL https://github.com/tectonic-typesetting/tectonic/releases/latest/download/tectonic-x86_64-unknown-linux-musl.tar.gz \
    -o /tmp/tectonic.tar.gz 2>/dev/null && \
    tar -xzf /tmp/tectonic.tar.gz -C /usr/local/bin/ 2>/dev/null && \
    rm /tmp/tectonic.tar.gz || echo "tectonic install skipped"

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# FIXED: Removed --with-deps to bypass the Debian/Ubuntu package conflict
RUN playwright install chromium

COPY . .

# Create storage directories
RUN mkdir -p /app/storage/resumes /app/storage/screenshots /app/storage/sessions

EXPOSE 8000

CMD ["python", "main.py"]
